# ==============================================================================
# REVENUE SURVIVAL AI AGENT — PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Revenue Survival AI Agent"
VERSION=1.0.0
ENVIRONMENT=production
DATABASE_URL=sqlite+aiosqlite:///./revenue_survival.db
# For PostgreSQL Production deployment:
# DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/revenue_survival

# AI / LLM Providers (Autonomous Simulation Fallback active if unset)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Multi-Channel Live Communication Providers
# 1. WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# 2. Twilio SMS / WhatsApp Fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 3. Email Provider (SendGrid API / SMTP)
SENDGRID_API_KEY=
FROM_EMAIL=deals@revenuesurvival.ai
FROM_NAME=Revenue Survival Real Estate Advisory

# Live Connector Credentials
TELEGRAM_BOT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
LINKEDIN_ACCESS_TOKEN=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
PORT=3000
