# =============================================================================
# REVENUE SURVIVAL AI — 24/7 CLOUD PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. Core Environment
ENVIRONMENT=production
ACTIVE_MISSION_ID=1
WORKER_INSTANCE_ID=REVENUE-DAEMON-CLOUD-PROD-01

# 2. Production Database Connection (Single Source of Truth)
# Example PostgreSQL / Supabase / Neon Connection:
# DATABASE_URL=postgresql+asyncpg://postgres:YourPassword@db.yourhost.supabase.co:5432/postgres
# Or persistent file path on cloud VM:
DATABASE_URL=sqlite+aiosqlite:////var/data/revenue_survival.db

# 3. Resend Enterprise Outbound & Inbound Email Infrastructure
RESEND_API_KEY=your_resend_api_key_here
EMAIL_SENDING_DOMAIN=altsofts.in
EMAIL_FROM=Revenue Survival AI <sales@altsofts.in>
EMAIL_REPLY_TO=sales@altsofts.in
RESEND_FROM_EMAIL=Revenue Survival AI <sales@altsofts.in>
RESEND_REPLY_TO=sales@altsofts.in
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here


# 4. API & Host Settings
HOST=0.0.0.0
PORT=8000
